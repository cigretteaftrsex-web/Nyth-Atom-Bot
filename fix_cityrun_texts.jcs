const fs = require('fs');
let code = fs.readFileSync('bot.ts', 'utf8');

// Fix Diamond Exchange text
const oldDiamondTitle = `let msg = "💎 <b>City Run Diamond Exchange</b>\\n\\n";
    msg += "💰 လက်ရှိ ဒင်္ဂါး (Coins): <b>" + coins + " ပြား</b>\\n\\n";`;
const newDiamondTitle = `let msg = "💎 <b>City Run Diamond Exchange</b>\\n\\n";
    const fDia = coins >= 1000 ? (coins / 1000).toFixed(1) + "K" : coins;
    msg += "💰 လက်ရှိ Diamond: <b>" + fDia + " (" + coins + ")</b>\\n\\n";`;
if (code.includes(oldDiamondTitle)) code = code.replace(oldDiamondTitle, newDiamondTitle);

const oldNotEnough = `msg += "\\n\\n⚠️ လဲလှယ်ရန် ဒင်္ဂါး မလုံလောက်သေးပါ။ အနည်းဆုံး 100 ပြား လိုအပ်ပါသည်။";`;
const newNotEnough = `msg += "\\n\\n⚠️ လဲလှယ်ရန် Diamond မလုံလောက်သေးပါ။ အနည်းဆုံး 100 လိုအပ်ပါသည်။";`;
if (code.includes(oldNotEnough)) code = code.replace(oldNotEnough, newNotEnough);

const oldAutoWait = `const waitMsg = await ctx.reply("⏳ ရှိသမျှဒင်္ဂါးများကို အများဆုံး Runs ရအောင် အလိုအလျောက် လဲလှယ်နေပါသည်...");`;
const newAutoWait = `const waitMsg = await ctx.reply("⏳ ရှိသမျှ Diamond များကို အများဆုံး Runs ရအောင် အလိုအလျောက် လဲလှယ်နေပါသည်...");`;
if (code.includes(oldAutoWait)) code = code.replace(oldAutoWait, newAutoWait);

const oldAutoSummary = `const exchangeText = "🎉 <b>အလိုအလျောက် လဲလှယ်ခြင်း ပြီးဆုံးပါပြီ။</b>\\n\\n💰 အသုံးပြုခဲ့သော ဒင်္ဂါး: <b>" + totalSpent + " ပြား</b>\\n🎟️ ရရှိသော ကစားခွင့်စုစုပေါင်း: <b>" + totalRunsGained + " ကြိမ်</b>";`;
const newAutoSummary = `const exchangeText = "🎉 <b>အလိုအလျောက် လဲလှယ်ခြင်း ပြီးဆုံးပါပြီ။</b>\\n\\n💰 အသုံးပြုခဲ့သော Diamond: <b>" + totalSpent + "</b>\\n🎟️ ရရှိသော ကစားခွင့်စုစုပေါင်း: <b>" + totalRunsGained + " ကြိမ်</b>";`;
if (code.includes(oldAutoSummary)) code = code.replace(oldAutoSummary, newAutoSummary);

const oldNotEnough2 = `await ctx.editMessageText("❌ လဲလှယ်ရန် ဒင်္ဂါး မလုံလောက်ပါ။");`;
const newNotEnough2 = `await ctx.editMessageText("❌ လဲလှယ်ရန် Diamond မလုံလောက်ပါ။");`;
if (code.includes(oldNotEnough2)) code = code.replace(oldNotEnough2, newNotEnough2);

const oldErrorMsg = `const errorMsg = res?.message || res?.description || "လဲလှယ်ရန် ဒင်္ဂါး မလုံလောက်ပါ။";`;
const newErrorMsg = `const errorMsg = res?.message || res?.description || "လဲလှယ်ရန် Diamond မလုံလောက်ပါ။";`;
if (code.includes(oldErrorMsg)) code = code.replace(oldErrorMsg, newErrorMsg);

const oldGameSuccess = `const successText = "🎉 <b>ဂုဏ်ယူပါတယ်။ ဂိမ်းကစားခြင်း ပြီးဆုံးပါပြီ။ (အမြင့်ဆုံးအမှတ် - " + lastScore + ")</b>\\n\\n💰 ရရှိသော ဒင်္ဂါး စုစုပေါင်း: <b>" + totalCoins + " ပြား</b>\\n🎟️ ရရှိသော ကစားခွင့် စုစုပေါင်း: <b>" + totalRuns + " ကြိမ်</b>";`;
const newGameSuccess = `const successText = "🎉 <b>ဂုဏ်ယူပါတယ်။ ဂိမ်းကစားခြင်း ပြီးဆုံးပါပြီ။ (အမြင့်ဆုံးအမှတ် - " + lastScore + ")</b>\\n\\n💰 ရရှိသော Diamond စုစုပေါင်း: <b>" + totalCoins + "</b>\\n🎟️ ရရှိသော ကစားခွင့် စုစုပေါင်း: <b>" + totalRuns + " ကြိမ်</b>";`;
if (code.includes(oldGameSuccess)) code = code.replace(oldGameSuccess, newGameSuccess);


// Update auto-play text too
const oldMilestoneText = `const progressText = "⏳ <b>အဆင့် (" + stageNum + "/" + unclaimedMilestones.length + ") ဆော့ကစားနေပါသည်...</b>\\n🏃‍♂️ ရည်မှန်းချက် အမှတ် (Score: " + score + ")\\n⏱️ စောင့်ဆိုင်းရန် (ခန့်မှန်း " + Math.ceil(waitTime/1000) + " စက္ကန့်)...";`;
const newMilestoneText = `const progressText = "⏳ <b>Milestone (" + stageNum + "/" + unclaimedMilestones.length + ") ဆော့ကစားနေပါသည်...</b>\\n🏃‍♂️ ရည်မှန်းချက် အမှတ် (Score: " + score + ")\\n⏱️ စောင့်ဆိုင်းရန် (ခန့်မှန်း " + Math.ceil(waitTime/1000) + " စက္ကန့်)...";`;
if (code.includes(oldMilestoneText)) code = code.replace(oldMilestoneText, newMilestoneText);

fs.writeFileSync('bot.ts', code);
console.log("Updated texts successfully.");
